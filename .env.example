# R4GV1S Configuration
# Copy this file to .env and fill in your values.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: openrouter | ollama | openai
LLM_PROVIDER=openrouter

# OpenRouter / OpenAI-compatible base URL
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# API key (OpenRouter or OpenAI)
API_KEY=your_api_key_here

# Model to use
# OpenRouter free examples: meta-llama/llama-3.3-70b-instruct:free, openrouter/free
# Ollama examples:          qwen2.5-coder:7b, deepseek-r1:8b
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Embedding ──────────────────────────────────────────────────────────────────
# Options: ollama | openai
# Ollama is recommended (free, local)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=pentest_kb

# ── RAG Tuning ─────────────────────────────────────────────────────────────────
TOP_K=6
MAX_TOOL_CALLS=4
TEMPERATURE=0.2

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
